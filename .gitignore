# Build. The glob covers the sanitizer and alternate-compiler trees CONTRIBUTING asks for.
build*/
_skbuild/
dist/
*.egg-info/
csrc/generated/
CMakeUserPresets.json

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.so

# Caches produced at runtime
.tessiq_cache/
*.cubin
*.ptx

# IR dumps (TESSIQ_DUMP_IR)
ir_dumps/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store

# Local working notes, never published. PLAN.md is the full design document; ROADMAP.md carries
# the part of it that belongs in the repository.
NOTES.local.md
PLAN.md
docs/architecture.md

# Per-PR working notes. The detail lives here; the PR itself carries a short summary.
PR_dev/
