// RUN: rewrite-fast-gelu
// fast_gelu declares float32 and float64, so a float16 graph keeps its three operations.
graph @forward(%arg0_1: f16[16,64]) -> f16[16,64] {
  %mul = aten.mul.Tensor(%arg0_1) {arg1 = 1.702} : f16[16,64]
  %sigmoid = aten.sigmoid.default(%mul) : f16[16,64]
  %mul_1 = aten.mul.Tensor(%arg0_1, %sigmoid) : f16[16,64]
  return %mul_1
}
// ---
graph @forward(%arg0_1: f16[16,64]) -> f16[16,64] {
  %mul = aten.mul.Tensor(%arg0_1) {arg1 = 1.702} : f16[16,64]
  %sigmoid = aten.sigmoid.default(%mul) : f16[16,64]
  %mul_1 = aten.mul.Tensor(%arg0_1, %sigmoid) : f16[16,64]
  return %mul_1
}
