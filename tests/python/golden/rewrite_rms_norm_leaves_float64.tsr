// RUN: rewrite-rms-norm
// rms_norm's kernel is float32 only, so a float64 graph keeps its six operations.
graph @forward(%arg0_1: f64[2,8,64], %arg1_1: f64[64]) -> f64[2,8,64] {
  %pow_1 = aten.pow.Tensor_Scalar(%arg0_1) {arg1 = 2} : f64[2,8,64]
  %mean = aten.mean.dim(%pow_1) {arg1 = [-1], arg2 = true} : f64[2,8,1]
  %add = aten.add.Tensor(%mean) {arg1 = 9.9999999999999995e-07} : f64[2,8,1]
  %rsqrt = aten.rsqrt.default(%add) : f64[2,8,1]
  %mul = aten.mul.Tensor(%arg0_1, %rsqrt) : f64[2,8,64]
  %mul_1 = aten.mul.Tensor(%mul, %arg1_1) : f64[2,8,64]
  return %mul_1
}
// ---
graph @forward(%arg0_1: f64[2,8,64], %arg1_1: f64[64]) -> f64[2,8,64] {
  %pow_1 = aten.pow.Tensor_Scalar(%arg0_1) {arg1 = 2} : f64[2,8,64]
  %mean = aten.mean.dim(%pow_1) {arg1 = [-1], arg2 = true} : f64[2,8,1]
  %add = aten.add.Tensor(%mean) {arg1 = 9.9999999999999995e-07} : f64[2,8,1]
  %rsqrt = aten.rsqrt.default(%add) : f64[2,8,1]
  %mul = aten.mul.Tensor(%arg0_1, %rsqrt) : f64[2,8,64]
  %mul_1 = aten.mul.Tensor(%mul, %arg1_1) : f64[2,8,64]
  return %mul_1
}
