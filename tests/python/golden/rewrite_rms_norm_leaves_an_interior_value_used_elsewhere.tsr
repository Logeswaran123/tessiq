// RUN: rewrite-rms-norm
// %rsqrt is also read by %scale, so the call would take a value %scale still needs. Unchanged.
graph @forward(%arg0_1: f32[2,8,64], %arg1_1: f32[64]) -> (f32[2,8,64], f32[2,8,1]) {
  %pow_1 = aten.pow.Tensor_Scalar(%arg0_1) {arg1 = 2} : f32[2,8,64]
  %mean = aten.mean.dim(%pow_1) {arg1 = [-1], arg2 = true} : f32[2,8,1]
  %add = aten.add.Tensor(%mean) {arg1 = 9.9999999999999995e-07} : f32[2,8,1]
  %rsqrt = aten.rsqrt.default(%add) : f32[2,8,1]
  %mul = aten.mul.Tensor(%arg0_1, %rsqrt) : f32[2,8,64]
  %mul_1 = aten.mul.Tensor(%mul, %arg1_1) : f32[2,8,64]
  %scale = aten.mul.Tensor(%rsqrt) {arg1 = 2.0} : f32[2,8,1]
  return %mul_1, %scale
}
// ---
graph @forward(%arg0_1: f32[2,8,64], %arg1_1: f32[64]) -> (f32[2,8,64], f32[2,8,1]) {
  %pow_1 = aten.pow.Tensor_Scalar(%arg0_1) {arg1 = 2} : f32[2,8,64]
  %mean = aten.mean.dim(%pow_1) {arg1 = [-1], arg2 = true} : f32[2,8,1]
  %add = aten.add.Tensor(%mean) {arg1 = 9.9999999999999995e-07} : f32[2,8,1]
  %rsqrt = aten.rsqrt.default(%add) : f32[2,8,1]
  %mul = aten.mul.Tensor(%arg0_1, %rsqrt) : f32[2,8,64]
  %mul_1 = aten.mul.Tensor(%mul, %arg1_1) : f32[2,8,64]
  %scale = aten.mul.Tensor(%rsqrt) {arg1 = 2.0} : f32[2,8,1]
  return %mul_1, %scale
}
