// RUN: mark-supported,cluster,fuse-elementwise
// %p is returned, so the caller reads it from memory. Keeping it in a register would mean not
// producing it at all.
graph @g(%x: f32[8]) -> (f32[8], f32[8]) {
  %p = aten.relu.default(%x) : f32[8]
  %c = aten.tanh.default(%p) : f32[8]
  return %p, %c
}
// ---
graph @g(%x: f32[8]) -> (f32[8], f32[8]) {
  %p = aten.relu.default(%x) {tessiq.cluster = 0, tessiq.supported = true} : f32[8]
  %c = aten.tanh.default(%p) {tessiq.cluster = 0, tessiq.supported = true} : f32[8]
  return %p, %c
}
