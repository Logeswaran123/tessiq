// RUN: cse,dce
graph @g(%a: f32[4], %b: f32[4]) -> f32[4] {
  %x = add(%a, %b) : f32[4]
  %y = add(%b, %a) : f32[4]
  %out = mul(%x, %y) : f32[4]
  return %out
}
// ---
graph @g(%a: f32[4], %b: f32[4]) -> f32[4] {
  %x = add(%a, %b) : f32[4]
  %y = add(%b, %a) : f32[4]
  %out = mul(%x, %y) : f32[4]
  return %out
}
