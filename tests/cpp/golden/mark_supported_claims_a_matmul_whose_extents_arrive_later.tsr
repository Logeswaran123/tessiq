// RUN: mark-supported
// BLAS takes m, n and k at the call, so a matmul is claimed whether or not the extents are known.
// Whether a transpose flag can describe each operand is decided when the kernel is built.
graph @g(%x: f32[?,32], %w: f32[32,64:1,32]) -> f32[?,64] {
  %p = aten.mm.default(%x, %w) : f32[?,64]
  return %p
}
// ---
graph @g(%x: f32[?,32], %w: f32[32,64:1,32]) -> f32[?,64] {
  %p = aten.mm.default(%x, %w) {tessiq.supported = true} : f32[?,64]
  return %p
}
