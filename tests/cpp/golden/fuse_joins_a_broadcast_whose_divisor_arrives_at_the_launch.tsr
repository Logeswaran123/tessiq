// RUN: mark-supported,cluster,fuse-elementwise
// A softmax's subtract with an unknown row length. Reading one value per row divides the output
// position by that length, so the divisor is a parameter the launch works out from the buffer
// sizes, and the group forms.
graph @g(%s: f32[?,4,?,?], %m: f32[?,4,?,1]) -> f32[?,4,?,?] {
  %d = aten.sub.Tensor(%s, %m) : f32[?,4,?,?]
  %e = aten.exp.default(%d) : f32[?,4,?,?]
  return %e
}
// ---
graph @g(%s: f32[?,4,?,?], %m: f32[?,4,?,1]) -> f32[?,4,?,?] {
  %d = aten.sub.Tensor(%s, %m) {tessiq.cluster = 0, tessiq.fusion = 0, tessiq.supported = true} : f32[?,4,?,?]
  %e = aten.exp.default(%d) {tessiq.cluster = 0, tessiq.fusion = 0, tessiq.supported = true} : f32[?,4,?,?]
  return %e
}
