// RUN: mark-supported,layout-assign
// A copy reads a strided input on purpose, and packing it first would make the copy twice. The
// strided operand of the elementwise multiply is still packed.
graph @g(%a: f32[4,8:1,4], %b: f32[4,8]) -> f32[4,8] {
  %c = aten.clone.default(%a) {memory_format = "torch.contiguous_format"} : f32[4,8]
  %m = aten.mul.Tensor(%c, %b) : f32[4,8]
  return %m
}
// ---
graph @g(%a: f32[4,8:1,4], %b: f32[4,8]) -> f32[4,8] {
  %c = aten.clone.default(%a) {memory_format = "torch.contiguous_format", tessiq.supported = true} : f32[4,8]
  %m = aten.mul.Tensor(%c, %b) {tessiq.supported = true} : f32[4,8]
  return %m
}
