// RUN: mark-supported,cluster
// The counterpart of cluster_leaves_a_movement_only_group_on_the_host.tsr. This unit has an
// operation that computes, so it is placed and the movement stays in it.
graph @g(%a: f32[4,8]) -> f32[8,4:1,8] {
  %r = aten.relu.default(%a) : f32[4,8]
  %p = aten.permute.default(%r) {arg1 = [1,0]} : f32[8,4:1,8]
  %n = aten.neg.default(%p) : f32[8,4:1,8]
  return %n
}
// ---
graph @g(%a: f32[4,8]) -> f32[8,4:1,8] {
  %r = aten.relu.default(%a) {tessiq.cluster = 0, tessiq.supported = true} : f32[4,8]
  %p = aten.permute.default(%r) {arg1 = [1,0], tessiq.cluster = 0, tessiq.supported = true} : f32[8,4:1,8]
  %n = aten.neg.default(%p) {tessiq.cluster = 0, tessiq.supported = true} : f32[8,4:1,8]
  return %n
}
