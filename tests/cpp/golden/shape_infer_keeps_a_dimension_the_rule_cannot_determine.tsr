// RUN: shape-infer
// The operand's batch size is unknown, so the rule cannot determine the result's. The graph
// already knew it, and a rule that cannot tell must not erase what is there.
graph @g(%a: f32[?,8]) -> f32[4,8] {
  %r = relu(%a) : f32[4,8]
  return %r
}
// ---
graph @g(%a: f32[?,8]) -> f32[4,8] {
  %r = relu(%a) : f32[4,8]
  return %r
}
