// RUN: mark-supported
// With unknown extents, a node is claimed only if its kernel can take them at launch. A reduction
// takes its three extents as arguments and a loop over same-shaped buffers takes its element
// count. A loop stepping through a permuted operand needs every extent in the source, so it is
// declined.
graph @g(%a: f32[?,4,8], %b: f32[?,4,8], %t: f32[4,8:1,4]) -> f32[?,4] {
  %m = aten.mul.Tensor(%a, %b) : f32[?,4,8]
  %x = aten.add.Tensor(%m, %t) : f32[?,4,8]
  %s = aten.sum.dim_IntList(%x) {arg1 = [2]} : f32[?,4]
  return %s
}
// ---
graph @g(%a: f32[?,4,8], %b: f32[?,4,8], %t: f32[4,8:1,4]) -> f32[?,4] {
  %m = aten.mul.Tensor(%a, %b) {tessiq.supported = true} : f32[?,4,8]
  %x = aten.add.Tensor(%m, %t) {tessiq.supported = false} : f32[?,4,8]
  %s = aten.sum.dim_IntList(%x) {arg1 = [2], tessiq.supported = true} : f32[?,4]
  return %s
}
