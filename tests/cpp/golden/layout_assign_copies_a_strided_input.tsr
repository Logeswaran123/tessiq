// RUN: mark-supported,layout-assign
// Every kernel reads p_in[i] and writes p_out[i], one index across every buffer, which is only
// the same elements when the buffers are laid out the same way. So a claimed operation reading a
// strided value needs that value packed first, and the copy is a node rather than something the
// runtime does silently.
graph @g(%a: f32[4,8:1,4], %b: f32[4,8]) -> f32[4,8] {
  %r = aten.relu.default(%a) : f32[4,8]
  %s = aten.add.Tensor(%r, %b) : f32[4,8]
  return %s
}
// ---
graph @g(%a: f32[4,8:1,4], %b: f32[4,8]) -> f32[4,8] {
  %a.contiguous = tessiq.contiguous(%a) {tessiq.supported = false} : f32[4,8]
  %r = aten.relu.default(%a.contiguous) {tessiq.supported = true} : f32[4,8]
  %s = aten.add.Tensor(%r, %b) {tessiq.supported = true} : f32[4,8]
  return %s
}
