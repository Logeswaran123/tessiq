// RUN: mark-supported,layout-assign
// Generated kernels index their buffers as packed, so a claimed operation reading a strided value
// needs it packed first. The executor does the packing; this records it as a node.
graph @g(%a: f32[4,8:1,4], %b: f32[4,8]) -> f32[4,8] {
  %r = aten.relu.default(%a) : f32[4,8]
  %s = aten.add.Tensor(%r, %b) : f32[4,8]
  return %s
}
// ---
graph @g(%a: f32[4,8:1,4], %b: f32[4,8]) -> f32[4,8] {
  %a.contiguous = tessiq.contiguous(%a) {tessiq.supported = false} : f32[4,8]
  %r = aten.relu.default(%a.contiguous) {tessiq.supported = true} : f32[4,8]
  %s = aten.add.Tensor(%r, %b) {tessiq.supported = true} : f32[4,8]
  return %s
}
