// RUN: shape-infer
// No rule for convolution, so its recorded type stands and feeds the op that does have one.
graph @g(%a: f32[1,3,8,8]) -> f32[?,?,?,?] {
  %c = aten.convolution.default(%a) : f32[1,16,8,8]
  %f = aten.relu.default(%c) : f32[?,?,?,?]
  return %f
}
// ---
graph @g(%a: f32[1,3,8,8]) -> f32[1,16,8,8] {
  %c = aten.convolution.default(%a) : f32[1,16,8,8]
  %f = aten.relu.default(%c) : f32[1,16,8,8]
  return %f
}
