// RUN: mark-supported
graph @g(%a: f32[4], %b: f32[4]) -> f32[4] {
  %x = aten.add.Tensor(%a, %b) : f32[4]
  %y = aten.mm.default(%x, %b) : f32[4]
  %z = aten.relu.default(%y) : f32[4]
  return %z
}
// ---
graph @g(%a: f32[4], %b: f32[4]) -> f32[4] {
  %x = aten.add.Tensor(%a, %b) {tessiq.supported = true} : f32[4]
  %y = aten.mm.default(%x, %b) {tessiq.supported = false} : f32[4]
  %z = aten.relu.default(%y) {tessiq.supported = true} : f32[4]
  return %z
}
