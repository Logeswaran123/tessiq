// RUN: mark-supported,cluster,fuse-elementwise
// %m is read by two operations. Fusing it into either still leaves the other needing it from
// memory, so it has to be written out regardless and stays out of the group.
graph @g(%a: f32[8], %b: f32[8]) -> f32[8] {
  %m = aten.mul.Tensor(%a, %b) : f32[8]
  %x = aten.relu.default(%m) : f32[8]
  %y = aten.tanh.default(%m) : f32[8]
  %z = aten.add.Tensor(%x, %y) : f32[8]
  return %z
}
// ---
graph @g(%a: f32[8], %b: f32[8]) -> f32[8] {
  %m = aten.mul.Tensor(%a, %b) {tessiq.cluster = 0, tessiq.supported = true} : f32[8]
  %x = aten.relu.default(%m) {tessiq.cluster = 0, tessiq.fusion = 0, tessiq.supported = true} : f32[8]
  %y = aten.tanh.default(%m) {tessiq.cluster = 0, tessiq.fusion = 0, tessiq.supported = true} : f32[8]
  %z = aten.add.Tensor(%x, %y) {tessiq.cluster = 0, tessiq.fusion = 0, tessiq.supported = true} : f32[8]
  return %z
}
