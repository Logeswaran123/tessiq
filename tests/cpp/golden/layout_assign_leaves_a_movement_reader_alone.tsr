// RUN: mark-supported,layout-assign
// A permute returns a view, so packing its input first would add a copy and give the same result.
graph @g(%a: f32[4,8:1,4]) -> f32[8,4] {
  %p = aten.permute.default(%a) {arg1 = [1,0]} : f32[8,4]
  return %p
}
// ---
graph @g(%a: f32[4,8:1,4]) -> f32[8,4] {
  %p = aten.permute.default(%a) {arg1 = [1,0], tessiq.supported = true} : f32[8,4]
  return %p
}
