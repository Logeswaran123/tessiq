// RUN: shape-infer
// torch spells sum(x) as the dim_IntList form with an empty list, and the .default spellings carry
// no list at all. Both mean every dimension, and both leave a rank-0 tensor.
//
// The result types are written out because a rank-0 result has no dimension to leave as `?`
// (f32[?] is rank 1). So this checks the other half of the pass: a recorded type must agree with
// the one the rule derives.
graph @g(%a: f32[4,8]) -> f32[] {
  %s = aten.sum.dim_IntList(%a) {arg1 = []} : f32[]
  %m = aten.mean.default(%a) : f32[]
  return %s
}
// ---
graph @g(%a: f32[4,8]) -> f32[] {
  %s = aten.sum.dim_IntList(%a) {arg1 = []} : f32[]
  %m = aten.mean.default(%a) : f32[]
  return %s
}
