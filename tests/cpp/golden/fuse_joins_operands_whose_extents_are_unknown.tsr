// RUN: mark-supported,cluster,fuse-elementwise
// A graph traced for more than one shape, so the extents are `?`. Every buffer has the same dim
// list, so one index walks them all and the kernel takes its element count at launch.
graph @g(%a: f32[?,32], %b: f32[?,32]) -> f32[?,32] {
  %m = aten.mul.Tensor(%a, %b) : f32[?,32]
  %r = aten.relu.default(%m) : f32[?,32]
  return %r
}
// ---
graph @g(%a: f32[?,32], %b: f32[?,32]) -> f32[?,32] {
  %m = aten.mul.Tensor(%a, %b) {tessiq.cluster = 0, tessiq.fusion = 0, tessiq.supported = true} : f32[?,32]
  %r = aten.relu.default(%m) {tessiq.cluster = 0, tessiq.fusion = 0, tessiq.supported = true} : f32[?,32]
  return %r
}
