// RUN: mark-supported,layout-assign
// An unclaimed operation runs on the host, which reads any layout, so its strided input is not
// packed.
graph @g(%a: f32[4,8:1,4]) -> f32[4,8] {
  %m = aten.hypot.default(%a, %a) : f32[4,8]
  return %m
}
// ---
graph @g(%a: f32[4,8:1,4]) -> f32[4,8] {
  %m = aten.hypot.default(%a, %a) {tessiq.supported = false} : f32[4,8]
  return %m
}
