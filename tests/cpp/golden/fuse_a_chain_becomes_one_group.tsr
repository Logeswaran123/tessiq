// RUN: mark-supported,cluster,fuse-elementwise
// (a*b + c).relu().sigmoid(). Four operations reading and writing the same positions, so one
// loop can compute all of them with the intermediates staying in registers.
graph @g(%a: f32[1024], %b: f32[1024], %c: f32[1024]) -> f32[1024] {
  %m = aten.mul.Tensor(%a, %b) : f32[1024]
  %s = aten.add.Tensor(%m, %c) : f32[1024]
  %r = aten.relu.default(%s) : f32[1024]
  %g = aten.sigmoid.default(%r) : f32[1024]
  return %g
}
// ---
graph @g(%a: f32[1024], %b: f32[1024], %c: f32[1024]) -> f32[1024] {
  %m = aten.mul.Tensor(%a, %b) {tessiq.cluster = 0, tessiq.fusion = 0, tessiq.supported = true} : f32[1024]
  %s = aten.add.Tensor(%m, %c) {tessiq.cluster = 0, tessiq.fusion = 0, tessiq.supported = true} : f32[1024]
  %r = aten.relu.default(%s) {tessiq.cluster = 0, tessiq.fusion = 0, tessiq.supported = true} : f32[1024]
  %g = aten.sigmoid.default(%r) {tessiq.cluster = 0, tessiq.fusion = 0, tessiq.supported = true} : f32[1024]
  return %g
}
