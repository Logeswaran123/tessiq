// RUN: mark-supported,cluster,fuse-elementwise
// A node that fuses with nothing still gets a group, and so a kernel. Without one it would run
// through the fallback, a transfer each way.
graph @g(%a: f32[8], %b: f32[8]) -> f32[8] {
  %s = aten.add.Tensor(%a, %b) : f32[8]
  return %s
}
// ---
graph @g(%a: f32[8], %b: f32[8]) -> f32[8] {
  %s = aten.add.Tensor(%a, %b) {tessiq.cluster = 0, tessiq.fusion = 0, tessiq.supported = true} : f32[8]
  return %s
}
