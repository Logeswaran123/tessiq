// RUN: mark-supported,cluster,fuse-elementwise
// A fused kernel reads p_in[i] and writes p_out[i], one index across every buffer, so an operand
// with fewer elements than the result has nothing at most of those indices. Subtracting a mean of
// one value per row is the common case and arrives from every softmax and layer norm. Nothing is
// wrong with the operation, only with putting it in this loop.
graph @g(%a: f32[4,8], %m: f32[4,1]) -> f32[4,8] {
  %s = aten.sub.Tensor(%a, %m) : f32[4,8]
  %e = aten.exp.default(%s) : f32[4,8]
  return %e
}
// ---
graph @g(%a: f32[4,8], %m: f32[4,1]) -> f32[4,8] {
  %s = aten.sub.Tensor(%a, %m) {tessiq.cluster = 0, tessiq.supported = true} : f32[4,8]
  %e = aten.exp.default(%s) {tessiq.cluster = 0, tessiq.supported = true} : f32[4,8]
  return %e
}
