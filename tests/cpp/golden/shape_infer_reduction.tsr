// RUN: shape-infer
// The reduced dimensions come from an attribute, so the rule reads the node, not only the operand
// types. Here it drops dimension 1.
graph @g(%a: f32[4,8,3]) -> f32[?,?] {
  %s = aten.sum.dim_IntList(%a) {arg1 = [1]} : f32[?,?]
  return %s
}
// ---
graph @g(%a: f32[4,8,3]) -> f32[4,3] {
  %s = aten.sum.dim_IntList(%a) {arg1 = [1]} : f32[4,3]
  return %s
}
