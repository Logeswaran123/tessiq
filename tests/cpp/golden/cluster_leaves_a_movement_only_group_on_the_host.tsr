// RUN: mark-supported,cluster
// A permute is a view on either side. Placing this unit on the device would copy the input
// across, take a view and copy it back, so it is claimed (tessiq.supported) but not placed (no
// tessiq.cluster).
graph @g(%a: f32[4,8]) -> f32[8,4:1,8] {
  %m = aten.hypot.default(%a, %a) : f32[4,8]
  %p = aten.permute.default(%m) {arg1 = [1,0]} : f32[8,4:1,8]
  return %p
}
// ---
graph @g(%a: f32[4,8]) -> f32[8,4:1,8] {
  %m = aten.hypot.default(%a, %a) {tessiq.supported = false} : f32[4,8]
  %p = aten.permute.default(%m) {arg1 = [1,0], tessiq.supported = true} : f32[8,4:1,8]
  return %p
}
