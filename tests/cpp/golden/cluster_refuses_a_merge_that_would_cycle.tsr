// RUN: mark-supported,cluster
// Merging by edges alone would put %x, %z and %w in one cluster. %y reads from that cluster and
// %w reads %y, so the cluster would have to run both before and after %y. The merge is refused
// and %w stays separate.
graph @g(%a: f32[4], %b: f32[4]) -> f32[4] {
  %x = aten.add.Tensor(%a, %b) : f32[4]
  %y = aten.hypot.default(%x, %b) : f32[4]
  %z = aten.mul.Tensor(%x, %a) : f32[4]
  %w = aten.sub.Tensor(%y, %z) : f32[4]
  return %w
}
// ---
graph @g(%a: f32[4], %b: f32[4]) -> f32[4] {
  %x = aten.add.Tensor(%a, %b) {tessiq.cluster = 0, tessiq.supported = true} : f32[4]
  %y = aten.hypot.default(%x, %b) {tessiq.supported = false} : f32[4]
  %z = aten.mul.Tensor(%x, %a) {tessiq.cluster = 0, tessiq.supported = true} : f32[4]
  %w = aten.sub.Tensor(%y, %z) {tessiq.cluster = 1, tessiq.supported = true} : f32[4]
  return %w
}
